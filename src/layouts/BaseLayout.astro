---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Rosmar Mendoza - Software Developer (Backend)",
  description = "Hoja de vida y Portafolio interactivo de Rosmar Alejandra Mendoza Canchica, Desarrolladora Backend especializada en Golang, Python, Java y Arquitecturas Escala Web."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Google Fonts & FontAwesome -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-purple-50/40 dark:bg-darkbg text-slate-900 dark:text-slate-100 font-sans min-h-screen transition-colors duration-300 antialiased selection:bg-violet-500 selection:text-white">
  <!-- Ambient Glowing Background Elements (No-print) -->
  <div class="fixed top-0 left-1/4 w-96 h-96 bg-violet-500/15 dark:bg-violet-600/20 rounded-full filter blur-[120px] pointer-events-none no-print"></div>
  <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-fuchsia-500/15 dark:bg-purple-600/20 rounded-full filter blur-[120px] pointer-events-none no-print"></div>

  <slot />
</body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = '/rosmar-cv';
---

<BaseLayout title="Rosmar Mendoza — Marca Personal | Backend • AI • Project Manager" description="Landing page de marca personal de Rosmar Alejandra Mendoza Canchica. Software Developer SSR especializada en Backend Engineering, IA y Project Management.">

  <!-- ===== NAVBAR ===== -->
  <nav id="brand-nav" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <!-- Logo -->
      <a href="#hero" class="flex items-center space-x-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-violet-600 via-purple-600 to-fuchsia-600 flex items-center justify-center font-extrabold text-white text-lg shadow-lg shadow-purple-500/25 group-hover:scale-110 transition-transform">
          RM
        </div>
        <span class="font-bold text-lg text-slate-900 dark:text-white tracking-tight hidden sm:block">Rosmar Mendoza</span>
      </a>

      <!-- Nav Links (desktop) -->
      <div class="hidden md:flex items-center space-x-6 text-sm font-semibold">
        <a href="#about" class="text-slate-600 dark:text-slate-300 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Sobre Mí</a>
        <a href="#pillars" class="text-slate-600 dark:text-slate-300 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Especialidades</a>
        <a href="#projects" class="text-slate-600 dark:text-slate-300 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Proyectos</a>
        <a href="#certifications" class="text-slate-600 dark:text-slate-300 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Certificaciones</a>
        <a href="#contact" class="text-slate-600 dark:text-slate-300 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Contacto</a>
      </div>

      <!-- Right Controls -->
      <div class="flex items-center gap-2">
        <!-- Theme Toggle -->
        <button id="brand-theme-toggle" class="p-2 rounded-xl bg-purple-100/70 dark:bg-slate-800/80 border border-purple-200 dark:border-purple-900/40 text-slate-700 dark:text-slate-300 hover:text-violet-700 dark:hover:text-white transition-colors" title="Cambiar Tema">
          <i id="brand-theme-icon" class="fas fa-moon text-sm"></i>
        </button>
        <!-- CTA: CV Interactivo -->
        <a href={`${base}/`} class="inline-flex items-center space-x-2 px-4 py-2 text-xs font-bold rounded-xl bg-violet-600 hover:bg-violet-700 dark:bg-violet-500 dark:hover:bg-violet-400 text-white dark:text-slate-950 shadow-lg shadow-violet-500/25 transition-all">
          <i class="fas fa-file-lines"></i>
          <span>CV Interactivo</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- ===== HERO SECTION ===== -->
  <section id="hero" class="relative min-h-screen flex items-center justify-center pt-16 overflow-hidden">
    <!-- Animated Background Orbs -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-violet-500/20 dark:bg-violet-600/30 rounded-full filter blur-[150px] animate-pulse"></div>
      <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-fuchsia-500/20 dark:bg-purple-600/25 rounded-full filter blur-[120px] animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-purple-400/15 dark:bg-violet-500/20 rounded-full filter blur-[100px] animate-pulse" style="animation-delay: 2s;"></div>
    </div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-8">
      <!-- Status Badge -->
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-emerald-100/80 dark:bg-emerald-500/10 border border-emerald-300 dark:border-emerald-500/30 text-emerald-800 dark:text-emerald-400 text-xs font-bold backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Disponible para nuevas oportunidades</span>
      </div>

      <!-- Main Title -->
      <div class="space-y-4">
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.1]">
          Rosmar Alejandra
          <br>
          <span class="gradient-text">Mendoza Canchica</span>
        </h1>
        <p class="text-lg sm:text-xl lg:text-2xl font-semibold text-violet-700 dark:text-violet-400 font-mono">
          Software Developer SSR &bull; AI Enabler &bull; Certified PM
        </p>
      </div>

      <!-- Headline -->
      <p class="max-w-3xl mx-auto text-base sm:text-lg lg:text-xl text-slate-600 dark:text-slate-300 leading-relaxed">
        Construyendo <strong class="text-violet-700 dark:text-violet-400">sistemas backend escalables</strong> y potenciando el desarrollo de software con <strong class="text-violet-700 dark:text-violet-400">Inteligencia Artificial</strong>. Experiencia en entornos de escala masiva, metodologías ágiles y liderazgo técnico.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 pt-4">
        <a href="https://github.com/rosmarmendoza" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center space-x-2 px-6 py-3 text-sm font-bold rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-xl shadow-slate-900/20 dark:shadow-white/10 transition-all hover:scale-105">
          <i class="fab fa-github text-lg"></i>
          <span>Explorar GitHub</span>
        </a>
        <a href={`${base}/`}
           class="inline-flex items-center space-x-2 px-6 py-3 text-sm font-bold rounded-2xl bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700 text-white shadow-xl shadow-violet-500/30 transition-all hover:scale-105">
          <i class="fas fa-file-lines text-lg"></i>
          <span>CV Interactivo Completo</span>
        </a>
        <a href="mailto:mendozarosmar@gmail.com"
           class="inline-flex items-center space-x-2 px-6 py-3 text-sm font-bold rounded-2xl glass-panel text-violet-700 dark:text-violet-300 hover:bg-violet-100 dark:hover:bg-violet-950/40 transition-all hover:scale-105">
          <i class="fas fa-envelope text-lg"></i>
          <span>Conectar</span>
        </a>
      </div>

      <!-- Scroll Indicator -->
      <div class="pt-8 animate-bounce">
        <i class="fas fa-chevron-down text-violet-400/60 text-2xl"></i>
      </div>
    </div>
  </section>

  <!-- ===== ABOUT / SNAPSHOT ===== -->
  <section id="about" class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 gradient-border shadow-xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <!-- Left: Text -->
        <div class="space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-mono font-bold text-violet-600 dark:text-violet-400 tracking-widest uppercase">Sobre Mí</span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
              Ingeniera en Informática
              <span class="gradient-text block mt-1">con visión de producto</span>
            </h2>
          </div>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Soy Rosmar Mendoza, desarrolladora backend semi-senior con más de <strong class="text-slate-900 dark:text-white">4 años de experiencia</strong> construyendo microservicios de alto tráfico en <strong class="text-slate-900 dark:text-white">Golang, Python y Java</strong>. Trabajé en <strong class="text-slate-900 dark:text-white">MercadoLibre</strong> manteniendo APIs con disponibilidad del 99%+ para millones de usuarios, y en el sector Fintech diseñando servicios financieros críticos.
          </p>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Creo firmemente que la <strong class="text-slate-900 dark:text-white">IA generativa</strong> es un multiplicador de productividad. Integro herramientas como <strong class="text-slate-900 dark:text-white">Cursor, Claude y LLMs</strong> en mi flujo de trabajo diario para escribir mejor código, más rápido y con mayor cobertura de pruebas.
          </p>
        </div>
        <!-- Right: Stats -->
        <div class="grid grid-cols-2 gap-4">
          <div class="glass-panel rounded-2xl p-5 text-center space-y-1 hover:border-violet-500/50 transition-all">
            <span class="text-3xl font-extrabold gradient-text">7+</span>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold">Años de Trayectoria</p>
          </div>
          <div class="glass-panel rounded-2xl p-5 text-center space-y-1 hover:border-violet-500/50 transition-all">
            <span class="text-3xl font-extrabold gradient-text">99%+</span>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold">SLA Disponibilidad</p>
          </div>
          <div class="glass-panel rounded-2xl p-5 text-center space-y-1 hover:border-violet-500/50 transition-all">
            <span class="text-3xl font-extrabold gradient-text">3</span>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold">Perfiles Técnicos</p>
          </div>
          <div class="glass-panel rounded-2xl p-5 text-center space-y-1 hover:border-violet-500/50 transition-all">
            <span class="text-3xl font-extrabold gradient-text">4</span>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold">Certificaciones</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 3 PILLARS ===== -->
  <section id="pillars" class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-24 space-y-12">
    <div class="text-center space-y-3">
      <span class="text-xs font-mono font-bold text-violet-600 dark:text-violet-400 tracking-widest uppercase">Especialidades</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
        Tres Pilares de <span class="gradient-text">Excelencia</span>
      </h2>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-500 dark:text-slate-400">
        Mi propuesta de valor se sostiene sobre tres ejes complementarios que me permiten aportar desde la arquitectura hasta la estrategia.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Pillar 1: Backend -->
      <div class="glass-panel rounded-3xl p-6 sm:p-8 space-y-5 gradient-border hover:scale-[1.02] transition-transform group">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-violet-600 to-purple-600 flex items-center justify-center shadow-lg shadow-violet-500/25 group-hover:scale-110 transition-transform">
          <i class="fas fa-server text-white text-xl"></i>
        </div>
        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">Backend Engineering</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Diseño y construcción de microservicios de alto tráfico y APIs RESTful robustas en <strong>Golang, Python y Java</strong>. Experiencia en arquitecturas distribuidas a escala masiva con SLAs del 99%+.
        </p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="px-2.5 py-1 rounded-lg bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold border border-violet-200 dark:border-violet-500/20">Golang</span>
          <span class="px-2.5 py-1 rounded-lg bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold border border-violet-200 dark:border-violet-500/20">Python</span>
          <span class="px-2.5 py-1 rounded-lg bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold border border-violet-200 dark:border-violet-500/20">Java</span>
          <span class="px-2.5 py-1 rounded-lg bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold border border-violet-200 dark:border-violet-500/20">REST APIs</span>
          <span class="px-2.5 py-1 rounded-lg bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold border border-violet-200 dark:border-violet-500/20">PostgreSQL</span>
          <span class="px-2.5 py-1 rounded-lg bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold border border-violet-200 dark:border-violet-500/20">AWS</span>
        </div>
      </div>

      <!-- Pillar 2: PM -->
      <div class="glass-panel rounded-3xl p-6 sm:p-8 space-y-5 gradient-border hover:scale-[1.02] transition-transform group">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-purple-600 to-fuchsia-600 flex items-center justify-center shadow-lg shadow-purple-500/25 group-hover:scale-110 transition-transform">
          <i class="fas fa-diagram-project text-white text-xl"></i>
        </div>
        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">Project Management</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Liderazgo de equipos técnicos con metodologías ágiles (<strong>Scrum, Kanban</strong>). Enfoque en entrega continua, gestión de stakeholders y toma de decisiones basada en datos. Certificaciones PMI.
        </p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="px-2.5 py-1 rounded-lg bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-300 text-[10px] font-bold border border-purple-200 dark:border-purple-500/20">Scrum</span>
          <span class="px-2.5 py-1 rounded-lg bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-300 text-[10px] font-bold border border-purple-200 dark:border-purple-500/20">Kanban</span>
          <span class="px-2.5 py-1 rounded-lg bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-300 text-[10px] font-bold border border-purple-200 dark:border-purple-500/20">PMI</span>
          <span class="px-2.5 py-1 rounded-lg bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-300 text-[10px] font-bold border border-purple-200 dark:border-purple-500/20">CPMAI™</span>
          <span class="px-2.5 py-1 rounded-lg bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-300 text-[10px] font-bold border border-purple-200 dark:border-purple-500/20">Jira</span>
        </div>
      </div>

      <!-- Pillar 3: AI -->
      <div class="glass-panel rounded-3xl p-6 sm:p-8 space-y-5 gradient-border hover:scale-[1.02] transition-transform group">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-fuchsia-600 to-rose-500 flex items-center justify-center shadow-lg shadow-fuchsia-500/25 group-hover:scale-110 transition-transform">
          <i class="fas fa-brain text-white text-xl"></i>
        </div>
        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">AI Engineering</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Integración de <strong>IA generativa</strong> en el ciclo de desarrollo: aceleración de coding con <strong>Cursor y Claude</strong>, diseño de agentes inteligentes, y evangelización de prácticas AI-first en equipos técnicos.
        </p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="px-2.5 py-1 rounded-lg bg-fuchsia-100 dark:bg-fuchsia-500/10 text-fuchsia-700 dark:text-fuchsia-300 text-[10px] font-bold border border-fuchsia-200 dark:border-fuchsia-500/20">Cursor</span>
          <span class="px-2.5 py-1 rounded-lg bg-fuchsia-100 dark:bg-fuchsia-500/10 text-fuchsia-700 dark:text-fuchsia-300 text-[10px] font-bold border border-fuchsia-200 dark:border-fuchsia-500/20">Claude</span>
          <span class="px-2.5 py-1 rounded-lg bg-fuchsia-100 dark:bg-fuchsia-500/10 text-fuchsia-700 dark:text-fuchsia-300 text-[10px] font-bold border border-fuchsia-200 dark:border-fuchsia-500/20">LLMs</span>
          <span class="px-2.5 py-1 rounded-lg bg-fuchsia-100 dark:bg-fuchsia-500/10 text-fuchsia-700 dark:text-fuchsia-300 text-[10px] font-bold border border-fuchsia-200 dark:border-fuchsia-500/20">AI Agents</span>
          <span class="px-2.5 py-1 rounded-lg bg-fuchsia-100 dark:bg-fuchsia-500/10 text-fuchsia-700 dark:text-fuchsia-300 text-[10px] font-bold border border-fuchsia-200 dark:border-fuchsia-500/20">Prompt Eng.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CAREER TIMELINE ===== -->
  <section id="projects" class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-24 space-y-12">
    <div class="text-center space-y-3">
      <span class="text-xs font-mono font-bold text-violet-600 dark:text-violet-400 tracking-widest uppercase">Trayectoria</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
        Experiencia <span class="gradient-text">Profesional</span>
      </h2>
    </div>

    <div class="space-y-6">
      <!-- MercadoLibre -->
      <div class="glass-panel rounded-2xl p-6 sm:p-8 gradient-border hover:border-violet-500/50 transition-all group">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div class="space-y-3 flex-1">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-yellow-100 dark:bg-yellow-500/10 flex items-center justify-center text-yellow-600 dark:text-yellow-400 font-extrabold text-sm border border-yellow-200 dark:border-yellow-500/20">
                ML
              </div>
              <div>
                <h3 class="font-extrabold text-slate-900 dark:text-white text-lg">MercadoLibre</h3>
                <p class="text-sm font-semibold text-violet-700 dark:text-violet-400 font-mono">Software Developer (Backend)</p>
              </div>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Desarrollo y mantenimiento de microservicios críticos en Golang y APIs RESTful de alto rendimiento a escala masiva. Bootcamp Backend de MercadoLibre en arquitectura distribuida, concurrencia y buenas prácticas de ingeniería.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="px-2 py-0.5 rounded-md bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold">Golang</span>
              <span class="px-2 py-0.5 rounded-md bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold">Java</span>
              <span class="px-2 py-0.5 rounded-md bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold">Microservicios</span>
              <span class="px-2 py-0.5 rounded-md bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold">SLA 99%+</span>
              <span class="px-2 py-0.5 rounded-md bg-violet-100 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 text-[10px] font-bold">Cursor / Claude</span>
            </div>
          </div>
          <span class="text-xs font-mono font-bold text-slate-500 dark:text-slate-400 whitespace-nowrap bg-purple-50 dark:bg-purple-500/5 px-3 py-1 rounded-full border border-purple-200 dark:border-purple-500/20">
            Ago 2023 — Jun 2026
          </span>
        </div>
      </div>

      <!-- Mo Technologies - Support L2 -->
      <div class="glass-panel rounded-2xl p-6 sm:p-8 hover:border-violet-500/50 transition-all group">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div class="space-y-3 flex-1">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-500/10 flex items-center justify-center text-blue-600 dark:text-blue-400 font-extrabold text-sm border border-blue-200 dark:border-blue-500/20">
                Mo
              </div>
              <div>
                <h3 class="font-extrabold text-slate-900 dark:text-white text-lg">Mo Technologies</h3>
                <p class="text-sm font-semibold text-violet-700 dark:text-violet-400 font-mono">Support L2</p>
              </div>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Soporte técnico de segundo nivel: resolución de incidencias en Jira Service Desk, debugging en Django y análisis de consultas PostgreSQL en entornos productivos.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="px-2 py-0.5 rounded-md bg-blue-100 dark:bg-blue-500/10 text-blue-700 dark:text-blue-300 text-[10px] font-bold">Django</span>
              <span class="px-2 py-0.5 rounded-md bg-blue-100 dark:bg-blue-500/10 text-blue-700 dark:text-blue-300 text-[10px] font-bold">PostgreSQL</span>
              <span class="px-2 py-0.5 rounded-md bg-blue-100 dark:bg-blue-500/10 text-blue-700 dark:text-blue-300 text-[10px] font-bold">Jira</span>
            </div>
          </div>
          <span class="text-xs font-mono font-bold text-slate-500 dark:text-slate-400 whitespace-nowrap bg-purple-50 dark:bg-purple-500/5 px-3 py-1 rounded-full border border-purple-200 dark:border-purple-500/20">
            Jul 2022 — Ago 2023
          </span>
        </div>
      </div>

      <!-- Mo Technologies - Intern -->
      <div class="glass-panel rounded-2xl p-6 sm:p-8 hover:border-violet-500/50 transition-all group">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div class="space-y-3 flex-1">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-500/10 flex items-center justify-center text-blue-600 dark:text-blue-400 font-extrabold text-sm border border-blue-200 dark:border-blue-500/20">
                Mo
              </div>
              <div>
                <h3 class="font-extrabold text-slate-900 dark:text-white text-lg">Mo Technologies</h3>
                <p class="text-sm font-semibold text-violet-700 dark:text-violet-400 font-mono">Backend Intern</p>
              </div>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Construcción e integración de servicios backend para productos crediticios y financieros. APIs RESTful en Python (FastAPI, Django) e integraciones con AWS y Webhooks.

---

<section class="glass-panel print-card rounded-3xl p-4 sm:p-10 gradient-border shadow-xl relative overflow-hidden">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 sm:gap-6">
    <div class="space-y-3 sm:space-y-4 max-w-3xl min-w-0">
      <!-- Status Badge -->
      <div class="inline-flex items-center space-x-2 px-2.5 sm:px-3.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-500/10 border border-emerald-300 dark:border-emerald-500/30 text-emerald-800 dark:text-emerald-400 text-[10px] sm:text-xs font-bold max-w-full">
        <span class="w-2 h-2 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse shrink-0"></span>
        <span data-i18n="badge_status" class="truncate">Disponible: Backend Developer | AI Engineer | Project Manager</span>
      </div>

      <!-- Title & Name -->
      <div>
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 print-text-dark leading-tight">
          Rosmar Alejandra Mendoza Canchica
        </h1>
        <p class="text-sm sm:text-lg lg:text-xl font-semibold text-sky-600 dark:text-sky-400 mt-1.5 sm:mt-2 font-mono leading-snug break-words" data-i18n="hero_role">
          Backend Developer | AI Engineer | Project Manager
        </p>
      </div>

      <!-- Summary -->
      <p id="profile-summary" class="text-slate-700 dark:text-slate-300 print-text-muted leading-relaxed text-xs sm:text-sm lg:text-base font-normal">
        <!-- Loaded dynamically -->
      </p>

      <!-- Contact & Social Pills -->
      <div class="pt-1 sm:pt-2 flex flex-wrap gap-1.5 sm:gap-2.5 text-[10px] sm:text-xs lg:text-sm">
        <a href="mailto:mendozarosmar@gmail.com" class="inline-flex items-center space-x-1.5 sm:space-x-2 px-2.5 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700/60 transition-all group min-w-0">
          <i class="fas fa-envelope text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform shrink-0"></i>
          <span class="font-medium truncate">mendozarosmar@gmail.com</span>
        </a>
        <a href="https://linkedin.com/in/rosmar-mendoza" target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-1.5 sm:space-x-2 px-2.5 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700/60 transition-all group">
          <i class="fab fa-linkedin text-blue-600 dark:text-blue-400 group-hover:scale-110 transition-transform shrink-0"></i>
          <span class="font-medium">LinkedIn</span>
        </a>
        <a href="https://github.com/rosmarmendoza" target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-1.5 sm:space-x-2 px-2.5 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700/60 transition-all group">
          <i class="fab fa-github text-purple-600 dark:text-purple-400 group-hover:scale-110 transition-transform shrink-0"></i>
          <span class="font-medium">GitHub</span>
        </a>
        <span class="inline-flex items-center space-x-1.5 sm:space-x-2 px-2.5 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-800 dark:text-slate-300 border border-slate-300 dark:border-slate-700/60">
          <i class="fas fa-location-dot text-rose-600 dark:text-rose-400 shrink-0"></i>
          <span class="font-medium">Colombia</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Key Highlights Stat Badges (Dynamic per profile) -->
  <div id="stats-container" class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mt-6 sm:mt-8 pt-4 sm:pt-6 border-t border-slate-200 dark:border-slate-800/80 print-card">
    <!-- Loaded dynamically -->
  </div>
</section>

---
---

<div id="json-modal" class="fixed inset-0 z-50 hidden bg-slate-950/70 backdrop-blur-md flex items-center justify-center p-2 sm:p-4 no-print">
  <div class="bg-slate-900 border border-purple-900/40 rounded-2xl sm:rounded-3xl w-full max-w-3xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
    <!-- Modal Header -->
    <div class="px-3 sm:px-6 py-3 sm:py-4 border-b border-purple-900/40 flex flex-wrap items-center justify-between gap-2 bg-slate-950">
      <div class="flex items-center space-x-2">
        <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-emerald-500"></span>
        <h3 class="font-mono font-bold text-slate-200 text-xs sm:text-sm">rosmar_cv.json</h3>
      </div>
      <div class="flex items-center gap-1.5 sm:space-x-2">
        <button id="modal-btn-copy" class="px-2 sm:px-3 py-1 text-[10px] sm:text-xs font-semibold bg-slate-800 hover:bg-purple-950/50 text-violet-300 rounded-lg border border-purple-800/60 transition-colors">
          <i class="fas fa-copy mr-0.5 sm:mr-1"></i> <span data-i18n="btn_copy_json">Copiar</span>
        </button>
        <button id="modal-btn-download" class="px-2 sm:px-3 py-1 text-[10px] sm:text-xs font-semibold bg-violet-600 hover:bg-violet-500 text-white rounded-lg transition-colors">
          <i class="fas fa-download mr-0.5 sm:mr-1"></i> <span data-i18n="btn_download_json">.json</span>
        </button>
        <button id="modal-btn-close" class="p-1 sm:p-1.5 text-slate-400 hover:text-white rounded-lg">
          <i class="fas fa-times text-base sm:text-lg"></i>
        </button>
      </div>
    </div>
    <!-- Modal Body -->
    <div class="p-3 sm:p-6 overflow-y-auto font-mono text-[10px] sm:text-xs text-violet-300 bg-slate-950/90 leading-relaxed">
      <pre id="json-content" class="whitespace-pre-wrap break-words"></pre>
    </div>
  </div>
</div>
